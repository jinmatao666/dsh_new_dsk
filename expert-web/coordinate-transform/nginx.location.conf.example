# Insert inside the existing ac.zjugis.com:3300 server block, before the /experts/ fallback.
# proxy_pass keeps the trailing slash so /experts/coordinate-transform/api/tasks maps to /api/tasks.
location /experts/coordinate-transform/ {
    client_max_body_size 20m;
    proxy_pass http://127.0.0.1:3307/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 190s;
    proxy_cookie_path / /experts/coordinate-transform/;
    # Cookie name on the expert backend is expert_coordinate_transform_session.
}
