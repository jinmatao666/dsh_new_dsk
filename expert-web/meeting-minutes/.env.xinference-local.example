# Linux same-host deployment: use compose.local-xinference.yml.
# The site is public only through your HTTPS reverse proxy; Xinference stays on loopback.
EXPERT_PUBLIC_URL=https://meetings.example.com
EXPERT_PLATFORM_REDEEM_URL=https://platform.example.com/api/expert-web/redeem
EXPERT_PROVIDER_CREDENTIAL=replace-with-server-only-credential
EXPERT_MODEL_URL=https://model.example.com/v1/chat/completions
EXPERT_MODEL=replace-with-minutes-model
EXPERT_MODEL_KEY=replace-with-server-only-key
EXPERT_ASR_URL=http://127.0.0.1:20330/v1/audio/transcriptions
EXPERT_ASR_MODEL=Qwen3-ASR-1.7B
# Leave empty only if the local Xinference endpoint has no authentication.
EXPERT_ASR_KEY=
EXPERT_ASR_PROTOCOL=multipart
EXPERT_RETENTION_DAYS=30
HOST=127.0.0.1
PORT=4303
