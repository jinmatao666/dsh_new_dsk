# Public Origin, NOT the /experts/ocr-extractor/ workbench URL.
EXPERT_PUBLIC_URL=http://ac.zjugis.com:3300
# Loopback requires same-host host networking.
EXPERT_PLATFORM_REDEEM_URL=http://127.0.0.1:13300/api/expert-web/redeem
EXPERT_PROVIDER_CREDENTIAL=replace-with-ocr-expert-provider-credential
# Official PaddleOCR general pipeline POST endpoint (administrator selects a free port).
PADDLEOCR_URL=http://127.0.0.1:18082/layout-parsing
PADDLEOCR_API=layout
PADDLEOCR_KEY=
EXPERT_ALLOW_HTTP_ENGINE=0
# Optional text-only formatter, required for custom field extraction.
EXPERT_MODEL_URL=
EXPERT_MODEL=
EXPERT_MODEL_KEY=
# Explicit opt-in for administrator-trusted HTTP models outside loopback.
EXPERT_ALLOW_HTTP_MODEL=0
EXPERT_DATA_DIR=/data
EXPERT_RETENTION_DAYS=30
HOST=127.0.0.1
PORT=3315
