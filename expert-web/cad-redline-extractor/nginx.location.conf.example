# Insert inside the existing ac.zjugis.com:3300 server block, before the /experts/ fallback.
# proxy_pass keeps the trailing slash so /experts/cad-redline-extractor/api/tasks maps to /api/tasks.
location /experts/cad-redline-extractor/ {
    client_max_body_size 80m;
    proxy_pass http://127.0.0.1:3309/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 190s;
    proxy_cookie_path / /experts/cad-redline-extractor/;
    # Cookie name on the expert backend is expert_cad_redline_extractor_session.
}
