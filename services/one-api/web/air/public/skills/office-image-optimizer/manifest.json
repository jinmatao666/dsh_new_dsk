    {
      "name": "maxHeight",
      "type": "number",
      "required": false,
      "description": "最大高度；0 表示不限制",
      "defaultValue": "0"
    },
    {
      "name": "outputDirectory",
      "type": "directory",
      "required": false,
      "description": "输出目录；留空时在输入文件旁创建独立目录"
