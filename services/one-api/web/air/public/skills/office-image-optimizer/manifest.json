  "params": [
    {
      "name": "inputPaths",
      "type": "files",
      "required": true,
      "description": "一个或多个图片"
    },
    {
      "name": "format",
      "type": "select",
      "required": true,
      "description": "输出格式",
      "options": [
        "jpg",
        "png",
        "webp"
      ],
      "defaultValue": "jpg"
    },
    {
      "name": "quality",
      "type": "number",
      "required": false,
      "description": "质量 1–100",
