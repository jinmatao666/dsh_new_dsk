PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# PostgreSQL 主业务库与账号中心库。密码包含 URL 保留字符时必须百分号编码。
# SQL_DSN=postgres://parvis_app:password@10.249.168.231:54321/oneapi?sslmode=disable&TimeZone=Asia%2FShanghai
# ACCOUNT_SQL_DSN=postgres://parvis_app:password@10.249.168.231:54321/account_center?sslmode=disable&TimeZone=Asia%2FShanghai

# === Parvis 私有化部署 ===
PARVIS_DEPLOYMENT_MODE=private
# 服务端实际开放的能力。客户端构建配置还需同时开启，双端取交集。
PARVIS_CAPABILITIES=remote_mcp,remote_skills,image_vision,ocr
# 私有化模式只允许明确列出的跨域来源；同域管理后台不受影响。
CORS_ALLOW_ORIGINS=http://tauri.localhost,tauri://localhost

# 渠道密钥数据库加密：必填，支持 32 字节原文、64 位 hex 或 base64。
# 生产部署后必须妥善备份；丢失将无法解密现有模型渠道密钥。
PARVIS_CHANNEL_KEY_ENCRYPTION_KEY=

# OneAPI 与 MCP 服务之间的内部鉴权密钥，两端必须一致。
PARVIS_MCP_INTERNAL_KEY=

# 省域平台唤起桌面端并自动登录；桌面端原有登录方式继续保留。
PARVIS_PROVINCE_SSO_ENABLED=false
# 私有化模式不使用公网默认值；启用省域登录前必须显式填写验票地址。
PARVIS_PROVINCE_TICKET_VALIDATE_URL=
PARVIS_PROVINCE_TICKET_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36
PARVIS_PROVINCE_ZERO_IS_ACTIVE=false
# AI Search 后端调用 Parvis 内部启动接口的共享密钥；不得发送到浏览器。
PARVIS_PROVINCE_SSO_INTERNAL_KEY=

# === 线上数据同步工具（后台工具箱 → 线上数据同步）===
# 线上源库连接（建议使用只读账号）。未配置时同步功能整体置灰。
# 线上源库仍为 MySQL，因此这里使用 MySQL DSN，而不是目标 PostgreSQL URL。
# SYNC_SOURCE_SQL_DSN=readonly:password@tcp(47.110.42.93:101)/oneapi
# 库名守护清单（逗号分隔）。当前服务连接的目标库命中清单时禁用同步，防止反向污染线上库。默认 oneapi。
# SYNC_PROD_DB_NAMES=oneapi
