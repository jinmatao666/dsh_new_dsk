# Copy through: python deploy.py init --image REGISTRY/one-api:VERSION-amd64
# Required: versioned image reference or sha256 digest. Never use latest.
DSH_IMAGE=REGISTRY/one-api:SET_VERSION-amd64
# Optional; linux/amd64 (default) or linux/arm64; must match the delivered image.
DSH_PLATFORM=linux/amd64
# Optional; use a different project name/ports/data directory for isolated tests.
COMPOSE_PROJECT_NAME=dsh-backend
DSH_BIND_ADDRESS=127.0.0.1
DSH_HTTP_PORT=3000
DSH_ORG_PORT=3001
DSH_DATA_DIR=./data
# Path prefixes, NOT URLs. Empty or / means root; no trailing slash.
# Root deployment defaults to empty. Example subpaths: /dsh-admin and /dsh-api.
DSH_ADMIN_PREFIX=
DSH_API_PREFIX=
# Complete EXTERNAL API base URL, including ALL path prefixes; required by this tool.
# Example: https://backend.example/dsh-api (desktop server address is this same URL).
# Root example: https://backend.example . Set this before starting.
DSH_PUBLIC_URL=
# Optional complete management URL for a different admin host; path must match DSH_ADMIN_PREFIX.
# Empty derives the API public origin plus DSH_ADMIN_PREFIX.
DSH_ADMIN_URL=
# Optional separate organization portal, default /business, on internal port 3001.
DSH_ORG_PREFIX=/business
# Comma-separated browser ORIGINS (scheme + host + optional port), never paths.
# Empty preserves existing Internet behavior; private mode uses desktop defaults.
# Add the local admin origin when hosted separately. No wildcard entries.
CORS_ALLOW_ORIGINS=http://tauri.localhost,tauri://localhost
# Trusted last-hop proxies, IP/CIDR only; empty disables forwarded-client-IP trust.
# Set to the local gateway/container network as appropriate. Never trust arbitrary clients.
DSH_TRUSTED_PROXIES=127.0.0.1,::1
# Required secrets; init generates each ONCE. Keep them with the local data backup.
SESSION_SECRET=
PARVIS_CHANNEL_KEY_ENCRYPTION_KEY=
# Optional deployment policy: public or private (backend default when unset); does not change the image.
PARVIS_DEPLOYMENT_MODE=public
# Optional capability allowlist; empty keeps all optional desktop capabilities disabled.
# Example: remote_skills,web_search,image_vision,ocr
PARVIS_CAPABILITIES=
# Optional databases. Empty SQL_DSN uses SQLite in /data/one-api.db.
# PostgreSQL example: postgres://user:ENCODED_PASSWORD@db:5432/oneapi?sslmode=require
# Existing MySQL DSNs remain supported. These addresses must be reachable from the container.
SQL_DSN=
ACCOUNT_SQL_DSN=
# Optional integrations: leave empty unless deployed. Experts are NOT prerequisites.
REDIS_CONN_STRING=
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
PARVIS_MCP_INTERNAL_KEY=
# Optional updater verification key, base64 public key; only required to publish signed updates.
DESKTOP_UPDATE_PUBLIC_KEY=
# Optional container timezone; default UTC.
TZ=UTC
# Additional existing backend environment variables may be appended here.
