DSH_ONE_API_VERSION=v1
DSH_ONE_API_BIND=127.0.0.1
DSH_ONE_API_PORT=3300

# Build-machine mirrors. These are used only while building the image; the
# exported image archive is self-contained for the offline server.
DOCKER_MIRROR=docker.m.daocloud.io
ALPINE_MIRROR=mirrors.tuna.tsinghua.edu.cn/alpine
NPM_REGISTRY=https://registry.npmmirror.com
GO_PROXY=https://goproxy.cn,direct
DSH_PUBLIC_BASE_URL=https://ai.zrzyt.zj.gov.cn:10086/dsh-api

# Point these at the separately copied/renamed DSH databases. Do not reuse the
# live Parvis database names for the customer deployment.
DSH_SQL_DSN=postgres://dsh_app:CHANGE_ME@db.example:5432/dsh_oneapi?sslmode=disable&TimeZone=Asia%2FShanghai
DSH_ACCOUNT_SQL_DSN=postgres://dsh_app:CHANGE_ME@db.example:5432/dsh_account_center?sslmode=disable&TimeZone=Asia%2FShanghai
DSH_SESSION_SECRET=CHANGE_ME_TO_A_NEW_RANDOM_SECRET
# If the copied database contains encrypted channel keys, use the encryption
# key that encrypted those rows. Generate a new key only when channels will be
# recreated or re-encrypted for DSH.
DSH_CHANNEL_KEY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHANNEL_KEY
DSH_REDIS_CONN_STRING=
# Desktop updates: public key only (Tauri base64 public key); never put a signing private key here.
DSH_DESKTOP_UPDATE_PUBLIC_KEY=dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RDdEQURENzA4OTRFRTcKUldUblRvbHczZHJYRlg3S00xdk1maXZiVWtnb3cyd1ZQa1loZDV6Q3VWZzZSK2J2aks5S09mN2wK
DSH_DESKTOP_UPDATE_HOST_DIR=/data/wanwei/desktop-updates
DSH_DESKTOP_UPDATE_MAX_BYTES=2147483648
