DSH_VERSION=1.0.0
DSH_PUBLIC_BASE_URL=https://ai.zrzyt.zj.gov.cn:10086/dsh-api
# Comma-separated browser origins permitted to call the OneAPI admin/API.
# Keep the two desktop origins; add the region's public/admin HTTPS origin
# whenever the OneAPI management page is served in a regular browser.
DSH_CORS_ALLOW_ORIGINS=http://tauri.localhost,tauri://localhost,https://ai.zrzyt.zj.gov.cn:10086
DSH_ONEAPI_PORT=3300

# Use the same PostgreSQL host, port, user, and password as Parvis, but point
# at the independently copied DSH databases.
DSH_SQL_DSN=postgres://parvis_app:CHANGE_ME_DATABASE_PASSWORD@db.example:5432/dsh_oneapi?sslmode=disable&TimeZone=Asia%2FShanghai
DSH_ACCOUNT_SQL_DSN=postgres://parvis_app:CHANGE_ME_DATABASE_PASSWORD@db.example:5432/dsh_account_center?sslmode=disable&TimeZone=Asia%2FShanghai

# Generate a new DSH session secret. Preserve the existing channel encryption
# key while the copied channel rows remain encrypted with that key.
DSH_SESSION_SECRET=CHANGE_ME_NEW_RANDOM_SESSION_SECRET
DSH_CHANNEL_KEY_ENCRYPTION_KEY=CHANGE_ME_EXISTING_64_HEX_CHANNEL_KEY

# Copy the cache to this DSH-owned path before starting the offline service.
DSH_TIKTOKEN_CACHE_HOST_DIR=/zjugis/dsh/shared/tiktoken-cache
