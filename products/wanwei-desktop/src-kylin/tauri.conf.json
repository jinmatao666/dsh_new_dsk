{
  "$schema": "https://schema.tauri.app/config/1",
  "package": { "productName": "Wanwei Buddy Kylin", "version": "0.1.0" },
  "build": { "distDir": "../shell", "devPath": "../shell", "withGlobalTauri": true },
  "tauri": {
    "windows": [],
    "allowlist": { "all": false, "shell": { "open": "^https?://.+" } },
    "security": { "csp": null },
    "systemTray": { "iconPath": "icons/32x32.png" },
    "bundle": {
      "active": true,
      "identifier": "com.wanwei.harness",
      "targets": ["deb", "appimage"],
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
      "resources": ["resources/**/*"],
      "deb": { "depends": ["libwebkit2gtk-4.0-37", "libgtk-3-0", "libappindicator3-1", "xdg-utils"] }
    }
  }
}
