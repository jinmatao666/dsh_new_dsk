{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "万维 Buddy 预览版",
  "version": "0.1.0",
  "identifier": "com.wanwei.harness.preview",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/server.json",
      "resources/runtime/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
