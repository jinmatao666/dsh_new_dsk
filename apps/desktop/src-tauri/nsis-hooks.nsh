; Close every process which Windows reports as holding Sharp's native library,
; then clear any orphan process launched from this installation directory.
!macro ZJUGIS_STOP_RUNNING_APP
  nsExec::Exec 'taskkill.exe /F /T /IM "ZJUGIS Harness.exe"'
  Pop $0
  nsExec::Exec 'taskkill.exe /F /T /IM dsh-desktop.exe'
  Pop $0
  System::Call 'Kernel32::SetEnvironmentVariable(t "ZJUGIS_INSTALL_ROOT", t "$INSTDIR")'
  nsExec::Exec 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
  StrCmp $0 "0" +3
  MessageBox MB_ICONSTOP "ZJUGIS Harness 的运行文件仍被占用。安装器已自动关闭可关闭的占用程序；请重启电脑后重新安装。"
  Abort
!macroend

!macro NSIS_HOOK_PREINSTALL
  !insertmacro ZJUGIS_STOP_RUNNING_APP
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro ZJUGIS_STOP_RUNNING_APP
!macroend
