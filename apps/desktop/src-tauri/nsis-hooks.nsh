; Stop processes launched from this installation before NSIS removes or replaces
; its runtime. The bounded wait is best effort: an exclusive DLL-handle probe
; is not authoritative and can fail because of antivirus scanning or ACLs.
; NSIS performs the actual replacement and reports any real write failure.
!macro ZJUGIS_STOP_RUNNING_APP
  System::Call 'Kernel32::SetEnvironmentVariable(t "ZJUGIS_INSTALL_ROOT", t "$INSTDIR")'
  nsExec::Exec 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
  Pop $0
!macroend

!macro NSIS_HOOK_PREINSTALL
  !insertmacro ZJUGIS_STOP_RUNNING_APP
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro ZJUGIS_STOP_RUNNING_APP
!macroend
